{
  // Start3D on Cloudflare Workers: static site (index.html) + API + Telegram bot.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "start3d",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // No database_id: Wrangler creates the "start3d" D1 database on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "start3d" }
  ],
  "observability": { "enabled": true },
  // Keep variables added in the dashboard (CARD_TEXT with payment details lives only there).
  "keep_vars": true,
  "vars": {
    "BOT_USERNAME": "start3d_baku_bot",
    "ADMIN_TG_ID": "",
    "DEPOSIT_PCT": "50"
  }
  // Set in the dashboard, never here: BOT_TOKEN, WEBHOOK_SECRET (secrets), CARD_TEXT (payment details).
}
